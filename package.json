{
  "name": "@zakkster/lite-sparks",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "1.3.0",
  "description": "Zero-GC, SoA spark and debris engine featuring vector velocity stretching, floor restitution, thermodynamic OKLCH heat gradients, and hyper-optimized ballistic physics. Ideal for impacts, welding, grinding, fireworks trails, and high energy VFX.",
  "type": "module",
  "main": "./SparkEngine.js",
  "module": "./SparkEngine.js",
  "types": "./SparkEngine.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./SparkEngine.d.ts",
      "node": "./SparkEngine.js",
      "import": "./SparkEngine.js",
      "default": "./SparkEngine.js"
    }
  },
  "files": [
    "SparkEngine.js",
    "SparkEngine.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/PeshoVurtoleta/lite-sparks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-sparks.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-sparks/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zakkster/lite-color": "^2.1.0"
  },
  "keywords": [
    "sparks",
    "spark-engine",
    "debris",
    "impact",
    "welding",
    "grinding",
    "particle-engine",
    "particle-system",
    "canvas",
    "2d",
    "oklch",
    "heat-gradient",
    "zero-gc",
    "soa",
    "ballistic",
    "restitution",
    "micro-vfx",
    "vfx",
    "javascript",
    "typescript",
    "zakkster",
    "lite-engine"
  ],
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.15.0",
    "@zakkster/lite-leak": "^1.8.1"
  },
  "scripts": {
    "test": "node --expose-gc --test test/*.test.js",
    "torture": "node --expose-gc test/torture.mjs",
    "verify": "npm test && npm run torture"
  }
}
